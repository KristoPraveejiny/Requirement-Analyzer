# Copy to .env and fill in locally. Never commit .env.
# OpenRouter API key (server-side only; never exposed to the browser)
OPENROUTER_API_KEY=
# Model slug on OpenRouter (see openrouter.ai/models). Leave commented out to use the
# server default. Don't put your real deploy value here: if the variable is marked
# secret on Netlify, its value appearing in the repo fails the deploy.
# OPENROUTER_MODEL=vendor/model-slug
# Backend port
PORT=8787
# Max sample-document upload size in MB
MAX_UPLOAD_MB=5
# Max number of pages to analyse per website
MAX_PAGES=8
# Requests per minute per IP for /api/generate
RATE_LIMIT_PER_MIN=10
# Set when behind a reverse proxy/load balancer (e.g. 1 for a single proxy hop) so rate limiting sees real client IPs
TRUST_PROXY=false

# Copy to .env and fill in locally. Never commit .env.
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Server-side only; never exposed to the browser. Leave empty for mock mode.
GEMINI_API_KEY=
# Gemini model ID. Leave commented out to use the server default (gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Optional overall budget for one /api/generate request (Netlify defaults it to 24000).
# REQUEST_TIMEOUT_MS=
# Backend port
PORT=8787
# Max sample-document upload size in MB
MAX_UPLOAD_MB=5
# Max number of pages to analyse per website
MAX_PAGES=8
# Requests per minute per IP for /api/generate
RATE_LIMIT_PER_MIN=10
# Set when behind a reverse proxy/load balancer (e.g. 1 for a single proxy hop) so rate limiting sees real client IPs
TRUST_PROXY=false
